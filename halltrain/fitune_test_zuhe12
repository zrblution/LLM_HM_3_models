    if eval "$cmd" 2>&1 | tee "$log_file"; then
        log "✅ 完成训练: $task_name"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        log "❌ 训练失败: $task_name (继续执行下一个任务)"
        echo "错误日志已保存至: $log_file"
        FAILED_TASKS+=("$task_name")
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi
    
    # 等待进程完全结束
    wait
    
    # 清理 GPU
    cleanup_gpu
}

# ============================================================================
# 主执行流程
# ============================================================================

log "开始 LLM-HM 自动化微调流程 (fitune_test_zuhe12)"
echo "总计 $TOTAL_TASKS 个训练任务"
echo "  - 第一组：lr=5e-6, gas=2 (8个模型)"
echo "  - 第二组：lr=1e-6, gas=4 (8个模型)"
echo "  - 第三组：lr=1e-5, gas=1 (3个模型)"
echo ""
echo "日志目录: $LOG_DIR"

# 初始清理
cleanup_gpu

# ============================================================================
# 第一组实验：lr=5e-6, gas=2
# ============================================================================

log "========== 第一组实验：lr=5e-6, gas=2 =========="

LR1="5e-6"
GAS1=2
BATCH_SIZE1=1
OUTPUT_ROOT1="/home/tos_data/LLM_HM_3_models/Fitune_model_ours_gas2_lr5e6"

# 定义第一组任务配置 (模型类型, 模型路径, 模型名称, Epoch, save_total_limit)
GROUP1_TASKS=(
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|1|"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|3|"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|5|"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|8|5"
    "qwen|$QWEN4B_BASE|qwen3-vl-4b|1|"
    "qwen|$QWEN4B_BASE|qwen3-vl-4b|3|"
    "ministral|$MINISTRAL3B_BASE|ministral-3-3b|1|"
    "ministral|$MINISTRAL3B_BASE|ministral-3-3b|3|"
)

for task_config in "${GROUP1_TASKS[@]}"; do
    IFS='|' read -r model_type model_path model_name epoch save_limit <<< "$task_config"
    
    output_dir="$OUTPUT_ROOT1/${epoch}-epoch/${model_name}"
    log_file="$LOG_DIR/${LR1}_${GAS1}_${epoch}epoch_${model_name}.log"
    task_name="Group1_${model_name}_${epoch}epoch"
    
    if [ "$model_type" == "qwen" ]; then
        train_qwen "$model_path" "$output_dir" "$epoch" "$LR1" "$GAS1" "$BATCH_SIZE1" "$save_limit" "$log_file" "$task_name"
    else
        train_ministral "$model_path" "$output_dir" "$epoch" "$LR1" "$GAS1" "$BATCH_SIZE1" "$save_limit" "$log_file" "$task_name"
    fi
done

# ============================================================================
# 第二组实验：lr=1e-6, gas=4
# ============================================================================

log "========== 第二组实验：lr=1e-6, gas=4 =========="

LR2="1e-6"
GAS2=4
BATCH_SIZE2=1
OUTPUT_ROOT2="/home/tos_data/LLM_HM_3_models/Fitune_model_ours_gas4_lr1e6"

# 定义第二组任务配置
GROUP2_TASKS=(
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|1|"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|3|"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|5|"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|8|5"
    "qwen|$QWEN4B_BASE|qwen3-vl-4b|1|"
    "qwen|$QWEN4B_BASE|qwen3-vl-4b|3|"
    "ministral|$MINISTRAL3B_BASE|ministral-3-3b|1|"
    "ministral|$MINISTRAL3B_BASE|ministral-3-3b|3|"
)

for task_config in "${GROUP2_TASKS[@]}"; do
    IFS='|' read -r model_type model_path model_name epoch save_limit <<< "$task_config"
    
    output_dir="$OUTPUT_ROOT2/${epoch}-epoch/${model_name}"
    log_file="$LOG_DIR/${LR2}_${GAS2}_${epoch}epoch_${model_name}.log"
    task_name="Group2_${model_name}_${epoch}epoch"
    
    if [ "$model_type" == "qwen" ]; then
        train_qwen "$model_path" "$output_dir" "$epoch" "$LR2" "$GAS2" "$BATCH_SIZE2" "$save_limit" "$log_file" "$task_name"
    else
        train_ministral "$model_path" "$output_dir" "$epoch" "$LR2" "$GAS2" "$BATCH_SIZE2" "$save_limit" "$log_file" "$task_name"
    fi
done

# ============================================================================
# 第三组实验：lr=1e-5, gas=1 (仅 qwen3-vl-2b)
# ============================================================================

log "========== 第三组实验：lr=1e-5, gas=1 (仅 qwen3-vl-2b) =========="

LR3="1e-5"
GAS3=1
BATCH_SIZE3=1
OUTPUT_ROOT3="/home/tos_data/LLM_HM_3_models/Fitune_model_ours_gas1_lr1e5"

# 创建输出根目录
mkdir -p "$OUTPUT_ROOT3"

# 定义第三组任务配置 (仅 qwen3-vl-2b，Epoch 5/8/10，均需 save_total_limit 5)
GROUP3_TASKS=(
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|5|5"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|8|5"
    "qwen|$QWEN2B_BASE|qwen3-vl-2b|10|5"
)

for task_config in "${GROUP3_TASKS[@]}"; do
    IFS='|' read -r model_type model_path model_name epoch save_limit <<< "$task_config"
    
    output_dir="$OUTPUT_ROOT3/${epoch}-epoch/${model_name}"
    log_file="$LOG_DIR/${LR3}_${GAS3}_${epoch}epoch_${model_name}.log"
    task_name="Group3_${model_name}_${epoch}epoch"
    
    train_qwen "$model_path" "$output_dir" "$epoch" "$LR3" "$GAS3" "$BATCH_SIZE3" "$save_limit" "$log_file" "$task_name"
done

# ============================================================================
# 完成
# ============================================================================

log "========== 所有训练任务完成！=========="
echo ""
echo "========================================"
echo "           训练结果统计"
echo "========================================"
echo "  总任务数: $TOTAL_TASKS"
echo "  ✅ 成功: $SUCCESS_COUNT 个任务"
echo "  ❌ 失败: $FAIL_COUNT 个任务"
echo ""

if [ ${#FAILED_TASKS[@]} -gt 0 ]; then
    echo "失败的任务列表："
    for task in "${FAILED_TASKS[@]}"; do
        echo "  - $task"
    done
    echo ""
fi

echo "输出目录结构："
echo ""
echo "第一组 (lr=5e-6, gas=2):"
echo "$OUTPUT_ROOT1/"
echo "├── 1-epoch/qwen3-vl-2b/"
echo "├── 3-epoch/qwen3-vl-2b/"
echo "├── 5-epoch/qwen3-vl-2b/"
echo "├── 8-epoch/qwen3-vl-2b/"
echo "├── 1-epoch/qwen3-vl-4b/"
echo "├── 3-epoch/qwen3-vl-4b/"
echo "├── 1-epoch/ministral-3-3b/"
echo "└── 3-epoch/ministral-3-3b/"
echo ""
echo "第二组 (lr=1e-6, gas=4):"
echo "$OUTPUT_ROOT2/"
echo "├── 1-epoch/qwen3-vl-2b/"
echo "├── 3-epoch/qwen3-vl-2b/"
echo "├── 5-epoch/qwen3-vl-2b/"
echo "├── 8-epoch/qwen3-vl-2b/"
echo "├── 1-epoch/qwen3-vl-4b/"
echo "├── 3-epoch/qwen3-vl-4b/"
echo "├── 1-epoch/ministral-3-3b/"
echo "└── 3-epoch/ministral-3-3b/"
echo ""
echo "第三组 (lr=1e-5, gas=1):"
echo "$OUTPUT_ROOT3/"
echo "├── 5-epoch/qwen3-vl-2b/"
echo "├── 8-epoch/qwen3-vl-2b/"
echo "└── 10-epoch/qwen3-vl-2b/"
echo ""
echo "日志目录: $LOG_DIR"
echo ""
log "训练流程结束于 $(date '+%Y-%m-%d %H:%M:%S')"

# 如果有失败的任务，返回非零退出码
if [ $FAIL_COUNT -gt 0 ]; then
    echo ""
    echo "⚠️  有 $FAIL_COUNT 个任务失败，请检查日志文件"
    exit 1
fi

exit 0
