#!/bin/bash
################################################################################
# fitune_test_zuhe12 - LLM-HM 自动化微调主控脚本
################################################################################
#
# 【功能说明】
# 本脚本用于自动化执行 19 个模型的微调任务，分为三组实验：
#   - 第一组：lr=5e-6, gas=2 (8个模型)
#   - 第二组：lr=1e-6, gas=4 (8个模型)
#   - 第三组：lr=1e-5, gas=1 (3个模型，仅qwen3-vl-2b)
#
# 【核心特性】
#   - 自动化执行：无需人工交互
#   - 错误处理：单个任务失败不影响后续任务
#   - 显存安全：任务间自动清理和等待
#   - 日志管理：统一存放在 /home/tos_data/LLM_HM_3_models/loss-logs
#
################################################################################

# 错误处理：单个任务失败时继续执行
set +e

# ============================================================================
# 全局配置
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# 日志目录
LOG_DIR="/home/tos_data/LLM_HM_3_models/loss-logs"
mkdir -p "$LOG_DIR"

# 基础模型路径
QWEN2B_BASE="./basemodel/Qwen3-VL-2B-Instruct"
QWEN4B_BASE="./basemodel/Qwen3-VL-4B-Instruct"
MINISTRAL3B_BASE="./basemodel/Ministral-3-3B-Instruct"

# 训练数据路径
DATA_JSON="./data/coco_2017.json"
IMG_DIR="./data/data"

# DeepSpeed 配置
DS_CONFIG="./ds/ds_z2_config.json"

# GPU 配置
export CUDA_VISIBLE_DEVICES=0,1,2,3
NPROC_PER_NODE=4

# 固定参数（Ours 配置）
ENABLE_EVIDENCE="true"
INJECT_POSITION="per_layer"
INJECT_OP="ours"
USE_UTILIZATION="true"
EVIDENCE_SOURCE="aligned"
LAMBDA_ORTH="1.0"
LAMBDA_CTR="1.0"

# 端口起始值
BASE_PORT=29500
CURRENT_PORT=$BASE_PORT

# 统计变量
TOTAL_TASKS=19
CURRENT_TASK=0
SUCCESS_COUNT=0
FAIL_COUNT=0
FAILED_TASKS=()

# ============================================================================
# 辅助函数
# ============================================================================

# 日志函数
log() {
    echo ""
    echo "========================================================================"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    echo "========================================================================"
    echo ""
}

# 清理 GPU 显存和僵尸进程
cleanup_gpu() {
    log "清理 GPU 显存和僵尸进程..."
    
    # 杀掉可能残留的 Python 训练进程
    pkill -9 -f "train_qwen.py" 2>/dev/null || true
    pkill -9 -f "train_ministral.py" 2>/dev/null || true
    pkill -9 -f "torchrun" 2>/dev/null || true
    
    # 清理 GPU 上的僵尸进程
    for gpu_id in 0 1 2 3; do
        fuser -k /dev/nvidia${gpu_id} 2>/dev/null || true
    done
    
    # 等待进程完全退出
    sleep 10
    
    # 清理 PyTorch 缓存
    python3 -c "import torch; torch.cuda.empty_cache()" 2>/dev/null || true
    
    # 清理分布式训练残留的共享内存
    rm -rf /dev/shm/nccl* 2>/dev/null || true
    
    # 额外等待 30 秒确保资源回收
    sleep 30
    
    log "GPU 清理完成"
}

# 获取下一个可用端口
get_next_port() {
    CURRENT_PORT=$((CURRENT_PORT + 1))
    echo $CURRENT_PORT
}

# ============================================================================
# 训练函数
# ============================================================================

# Qwen 模型训练函数
train_qwen() {
    local model_path="$1"
    local output_dir="$2"
    local num_epochs="$3"
    local lr="$4"
    local gas="$5"
    local batch_size="$6"
    local save_total_limit="$7"
    local log_file="$8"
    local task_name="$9"
    
    local port=$(get_next_port)
    
    CURRENT_TASK=$((CURRENT_TASK + 1))
    
    log "[$CURRENT_TASK/$TOTAL_TASKS] 开始训练: $task_name"
    echo "  模型路径: $model_path"
    echo "  输出目录: $output_dir"
    echo "  日志文件: $log_file"
    echo "  参数: epochs=$num_epochs, lr=$lr, gas=$gas, batch_size=$batch_size"
    echo "  端口: $port"
    
    mkdir -p "$output_dir"
    
    # 设置环境变量
    export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    
    # 构建命令
    local cmd="torchrun --nnodes 1 --nproc_per_node $NPROC_PER_NODE --master-port $port \
        train/train_qwen.py \
        --model_name_or_path \"$model_path\" \
        --training_data_path \"$DATA_JSON\" \
        --training_image_dir \"$IMG_DIR\" \
        --output_dir \"$output_dir\" \
        --report_to none \
        --per_device_train_batch_size $batch_size \
        --gradient_accumulation_steps $gas \
        --learning_rate $lr \
        --num_train_epochs $num_epochs \
        --bf16 true \
        --resume_from_checkpoint False \
        --save_strategy epoch \
        --logging_steps 2 \
        --remove_unused_columns False \
        --deepspeed \"$DS_CONFIG\" \
        --enable_evidence $ENABLE_EVIDENCE \
        --inject_position \"$INJECT_POSITION\" \
        --inject_op \"$INJECT_OP\" \
        --use_utilization $USE_UTILIZATION \
        --evidence_source \"$EVIDENCE_SOURCE\" \
        --lambda_orth $LAMBDA_ORTH \
        --lambda_ctr $LAMBDA_CTR \
        --tau 0.07 \
        --aux_layers \"\""
    
    # 如果指定了 save_total_limit，添加该参数
    if [ -n "$save_total_limit" ]; then
        cmd="$cmd --save_total_limit $save_total_limit"
    fi
    
    # 执行训练并记录日志（使用 tee 同时输出到终端和日志文件）
    if eval "$cmd" 2>&1 | tee "$log_file"; then
        log "✅ 完成训练: $task_name"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        log "❌ 训练失败: $task_name (继续执行下一个任务)"
        echo "错误日志已保存至: $log_file"
        FAILED_TASKS+=("$task_name")
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi
    
    # 等待进程完全结束
    wait
    
    # 清理 GPU
    cleanup_gpu
}

